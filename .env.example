# Copy to .env and fill in. Never commit .env.
# ---- LLM providers (free tiers) ----
GROQ_API_KEY=""            # https://console.groq.com/keys
GEMINI_API_KEY=""          # https://aistudio.google.com/apikey (GOOGLE_API_KEY also accepted)

# Optional model overrides. Defaults were checked against the provider model lists in Oct 2026.
# GROQ_MODEL="openai/gpt-oss-20b"
# GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"
# GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
# GEMINI_LAST_RESORT_MODEL="gemini-3.5-flash"

# ---- Stock broker: Alpaca PAPER trading (leave empty to use the built-in simulator) ----
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# ---- Crypto broker via CCXT testnet/sandbox (leave empty to use the built-in simulator) ----
# These are the names the broker AND the Settings page read.
CRYPTO_EXCHANGE="binance"
CRYPTO_API_KEY=""
CRYPTO_API_SECRET=""
CRYPTO_SANDBOX="true"

# ---- News sources (optional) ----
CRYPTOPANIC_API_KEY=""
FINNHUB_API_KEY=""

# ---- Database ----
# SQLite path is set in prisma/schema.prisma (file:./dev.db); no env var needed.

# Risk limits (1% risk/trade, 3% daily loss, 5 positions, 20% exposure) are NOT environment variables.
# They are stored in the database and edited on the Settings page.
